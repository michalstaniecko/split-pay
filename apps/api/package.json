{
  "name": "@split-pay/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./client": "./src/client.ts"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsdown",
    "start": "node dist/index.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@better-auth/expo": "^1.7.27",
    "@hono/node-server": "^2.1.11",
    "@hono/zod-validator": "^0.7.6",
    "@sentry/node": "^11.17.0",
    "@split-pay/shared": "workspace:*",
    "better-auth": "^1.7.27",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.20",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/pg": "^8.23.1",
    "auth": "^1.7.27",
    "drizzle-kit": "^0.31.11",
    "tsdown": "^0.23.7",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "unrun": "^0.3.1",
    "vitest": "^4.1.4"
  }
}
