PORT=3000
# Local Postgres from compose.yaml (`pnpm db:up`).
DATABASE_URL=postgres://splitpay:splitpay@localhost:5432/splitpay
# Better Auth: at least 32 random characters (`openssl rand -base64 32`).
BETTER_AUTH_SECRET=change-me-to-32-or-more-random-characters
# Public origin of this API (where /api/auth is served).
BETTER_AUTH_URL=http://localhost:3000
# Optional feature flags served at GET /flags, as JSON (unknown/invalid flags stay off).
# FEATURE_FLAGS={"ads":false}
# Origin of the web app (view-only group link pages); link previews at /og/:token redirect there.
# WEB_URL=https://app.example.com
# Optional: Frankfurter instance for the daily ECB rate job (default https://api.frankfurter.dev).
# FRANKFURTER_URL=https://api.frankfurter.dev
# Photo bucket (ADR-0006), any S3-compatible store. Local: the `s3` service in compose.yaml
# (`pnpm db:up` starts it and creates the bucket). Android emulator: use http://10.0.2.2:9000,
# a real phone: your computer's LAN IP — the phone uploads to this endpoint directly.
# Production: Hetzner Object Storage, e.g. S3_ENDPOINT=https://fsn1.your-objectstorage.com,
# S3_REGION=fsn1, S3_FORCE_PATH_STYLE=false. Without these, photo routes answer 503.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=splitpay-photos
S3_ACCESS_KEY_ID=splitpay
S3_SECRET_ACCESS_KEY=splitpay-secret
S3_FORCE_PATH_STYLE=true
# Push notifications: `expo` sends through the Expo push service; unset = log them to the console.
# PUSH_SENDER=expo
# Only when "enhanced push security" is enabled in the Expo project.
# EXPO_ACCESS_TOKEN=
