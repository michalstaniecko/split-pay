PORT=3000
# Local Postgres from compose.yaml (`pnpm db:up`).
DATABASE_URL=postgres://splitpay:splitpay@localhost:5432/splitpay
# Better Auth: at least 32 random characters (`openssl rand -base64 32`).
BETTER_AUTH_SECRET=change-me-to-32-or-more-random-characters
# Public origin of this API (where /api/auth is served).
BETTER_AUTH_URL=http://localhost:3000
# Admin panel (content reports, account blocking): comma-separated emails of admins. They sign in
# with email OTP like any user; no separate admin accounts. Unset = no admins.
# ADMIN_EMAILS=you@example.com
# Optional feature flags served at GET /flags, as JSON (unknown/invalid flags stay off).
# FEATURE_FLAGS={"ads":false}
# Origin of the web app (view-only group link pages); link previews at /og/:token redirect there.
# WEB_URL=https://app.example.com
# Optional: Frankfurter instance for the daily ECB rate job (default https://api.frankfurter.dev).
# FRANKFURTER_URL=https://api.frankfurter.dev
# Photo bucket (ADR-0006, ADR-0020), any S3-compatible store with presigned PUT. Local: the `s3`
# service in compose.yaml (`pnpm db:up` starts it and creates the bucket). Android emulator: use
# http://10.0.2.2:9000, a real phone: your computer's LAN IP — the phone uploads to this endpoint
# directly. Staging/production: Cloudflare R2 with an EU-jurisdiction bucket (docs/runbook.md):
#   S3_ENDPOINT=https://<account-id>.eu.r2.cloudflarestorage.com
#   S3_REGION=auto
#   S3_BUCKET=split-pay-stage
#   S3_FORCE_PATH_STYLE=true
# Without these, photo routes answer 503.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=splitpay-photos
S3_ACCESS_KEY_ID=splitpay
S3_SECRET_ACCESS_KEY=splitpay-secret
S3_FORCE_PATH_STYLE=true
# Push notifications: `expo` sends through the Expo push service; unset = log them to the console.
# PUSH_SENDER=expo
# Only when "enhanced push security" is enabled in the Expo project.
# EXPO_ACCESS_TOKEN=
# Error reporting (Sentry). Unset SENTRY_DSN = off (local dev). Events carry no personal data:
# the SDK collects no user info, cookies, bodies or query strings, and every event goes through
# the shared scrubber (@split-pay/shared `scrubErrorReport`). Only a user id is sent.
# SENTRY_DSN=https://<key>@<org>.ingest.de.sentry.io/<project>
# staging | production
# SENTRY_ENVIRONMENT=staging
