# Web app server (apps/mobile/Dockerfile). TLS is terminated by the reverse proxy in
# front (Coolify), so this listens on plain HTTP.
{
	admin off
	auto_https off
}

:8080 {
	encode zstd gzip

	# Universal links / App Links (#88), written at startup by entrypoint.sh.
	# Apple wants application/json, served directly (no redirect).
	handle /.well-known/apple-app-site-association {
		root * /srv/assoc
		header Content-Type application/json
		file_server
	}
	handle /.well-known/assetlinks.json {
		root * /srv/assoc
		header Content-Type application/json
		file_server
	}

	# Messenger link previews: crawlers asking for a group link get the API's Open
	# Graph page (/og/:token), proxied so the preview keeps the web URL. People get the SPA.
	@og_crawler {
		path_regexp group ^/g/([^/]+)/?$
		header_regexp User-Agent (?i)(facebookexternalhit|facebot|meta-externalagent|twitterbot|slackbot|discordbot|telegrambot|whatsapp|linkedinbot|skypeuripreview|pinterest|redditbot|applebot|googlebot|bingbot|embedly|iframely|viber|snapchat|mastodon|bluesky)
	}
	handle @og_crawler {
		rewrite * /og/{re.group.1}
		reverse_proxy {$API_URL} {
			header_up Host {upstream_hostport}
		}
	}

	# The SPA (expo export -p web, web.output "single"): unknown paths, /g/* in
	# particular, get index.html. Hashed bundles can be cached for good.
	handle {
		root * /srv/app
		header /_expo/static/* Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}
