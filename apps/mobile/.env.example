# Origin of apps/api. On a device use your Mac's LAN IP (Android emulator: http://10.0.2.2:3000).
EXPO_PUBLIC_API_URL=http://localhost:3000
# Base URL of the web app used in group links (e.g. https://app.example.com). Leave empty until the
# domain exists: links then use the app scheme (splitpay://g/<token>).
EXPO_PUBLIC_WEB_URL=
# Store listings for the web view's "download the app" button (empty until published: links to the repo).
EXPO_PUBLIC_APP_STORE_URL=
EXPO_PUBLIC_PLAY_STORE_URL=
# Error reporting (Sentry). Empty = off (local dev). Events carry no personal data: no screenshots,
# no default PII, and every event goes through the shared scrubber; only the user id is sent.
EXPO_PUBLIC_SENTRY_DSN=
# staging | production
EXPO_PUBLIC_SENTRY_ENVIRONMENT=
# Optional source map / debug symbol upload during native builds (app.config.ts). Without
# SENTRY_AUTH_TOKEN the upload is skipped. Never commit the token: set it in your shell (or the gitignored .env).
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_URL=https://de.sentry.io/
