# Origin of apps/api. On a device use your Mac's LAN IP (Android emulator: http://10.0.2.2:3000).
EXPO_PUBLIC_API_URL=http://localhost:3000
# Base URL of the web app used in group links (e.g. https://app.example.com). Leave empty until the
# domain exists: links then use the app scheme (splitpay://g/<token>).
EXPO_PUBLIC_WEB_URL=
# Store listings for the web view's "download the app" button (empty until published: links to the repo).
EXPO_PUBLIC_APP_STORE_URL=
EXPO_PUBLIC_PLAY_STORE_URL=
